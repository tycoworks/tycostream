{
  "name": "tycostream-core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "workspaces": [
    ".",
    "demo"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:utils": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-utils.json",
    "e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "demo": "(cd demo && ts-node environment.ts &) && cd demo && vite",
    "prepare": "husky"
  },
  "dependencies": {
    "@graphql-yoga/nestjs": "^5.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.11.0",
    "graphql-yoga": "^6.0.1",
    "js-yaml": "^5.5.0",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "pg-type-names": "^1.0.0",
    "pg-types": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "rxjs-for-await": "^1.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@graphql-yoga/apollo-link": "^6.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": "eslint --fix"
  }
}
